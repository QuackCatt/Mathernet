# Local storage. Keep personal notes out of version control.
MATHERNET_DATA_PATH=data/mathernet.json
MATHERNET_SEARCH_CACHE_PATH=data/search_cache.json

# Course MCP Web Search server. Use exactly one transport below.
MCP_TRANSPORT=stdio
MCP_SERVER_COMMAND=
# MCP_HTTP_URL=
# MCP_HTTP_HEADERS_JSON={"Authorization":"Bearer replace-me"}
MCP_TOOL_NAME=search
MCP_APPROVED_PUBLISHERS=Wikipedia,Wolfram MathWorld,Khan Academy,MIT OpenCourseWare,Stanford Encyclopedia of Philosophy,University

# Optional model-backed synthesis. Without a key, Mathernet preserves sources but does not invent derivations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

MATHERNET_TIMEOUT_SECONDS=30
